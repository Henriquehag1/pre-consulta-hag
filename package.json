{
  "name": "hag-run-development",
  "version": "0.1.0",
  "private": true,
  "description": "Checks locais do HAG RUN, sem dependências externas.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:postgres": "bash scripts/test-hag-run-postgres.sh",
    "test:supabase": "bash scripts/test-hag-run-supabase-local.sh",
    "test:ui": "node tests/ui/hag_run_mobile.test.js",
    "check": "node scripts/check-hag-run.mjs",
    "verify": "npm test && npm run check"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
